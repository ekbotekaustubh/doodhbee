# ==============================================================================
# DoodhDesk SaaS - Production Environment Configuration
# Copy this file to .env and configure with your production credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Debugging
# ------------------------------------------------------------------------------
APP_NAME="DoodhDesk SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.doodhdesk.com
APP_TIMEZONE=Asia/Kolkata

# Set to false in production to disable demo auto-logins, quick-switcher toolbars, and demo routes
ALLOW_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB 10.5+)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doodhdesk_prod
DB_USERNAME=doodhdesk_user
DB_PASSWORD="ChangeThisToAStrongRandomPassword!"

# ------------------------------------------------------------------------------
# URL & Web Server Routing
# ------------------------------------------------------------------------------
# Set to false when DocumentRoot is pointed to public/ (or mod_rewrite is enabled)
APP_USE_INDEX_IN_URL=false
APP_REWRITE_ENABLED=true

# ------------------------------------------------------------------------------
# Session & Security
# ------------------------------------------------------------------------------
# Set to true when serving over HTTPS
SESSION_SECURE_COOKIE=true
