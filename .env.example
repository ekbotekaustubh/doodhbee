# ==============================================================================
# DoodhBee SaaS - Production Environment Configuration
# Copy this file to .env and configure with your production credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Debugging
# ------------------------------------------------------------------------------
APP_NAME="DoodhBee SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.doodhbee.com
APP_TIMEZONE=Asia/Kolkata

# Set to false in production to disable demo auto-logins, quick-switcher toolbars, and demo routes
ALLOW_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB 10.5+)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doodhbee_prod
DB_USERNAME=doodhbee_user
DB_PASSWORD="ChangeThisToAStrongRandomPassword!"

# ------------------------------------------------------------------------------
# URL & Web Server Routing
# ------------------------------------------------------------------------------
# Set to false when DocumentRoot is pointed to public/ (or mod_rewrite is enabled)
APP_USE_INDEX_IN_URL=false
APP_REWRITE_ENABLED=true

# ------------------------------------------------------------------------------
# Session & Security
# ------------------------------------------------------------------------------
# Set to true when serving over HTTPS
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# Outgoing Email (SMTP) for Subscription GST Invoices
# ------------------------------------------------------------------------------
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=hello@doodhbee.com
MAIL_FROM_NAME="Shri Ram Open Source Technologies"

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Optional fallback if not configured in Super Admin UI)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_U5DntV3XH8BB8K
RAZORPAY_KEY_SECRET=1hGgq4aob2VY2Z3CU6y9efJn
RAZORPAY_WEBHOOK_SECRET=
